{
  "name": "humanqa",
  "version": "0.1.1",
  "description": "Evidence-first product quality checks for web apps",
  "type": "module",
  "license": "Apache-2.0",
  "author": "HumanQA contributors",
  "homepage": "https://humanqa-nine.vercel.app/",
  "repository": {
    "type": "git",
