    "@humanqa/github": "workspace:*",
    "@humanqa/pack-sdk": "workspace:*",
    "@humanqa/reporters": "workspace:*",
    "@humanqa/scorer": "workspace:*",
    "@humanqa/test-generator": "workspace:*",
    "commander": "14.0.0",
    "yaml": "2.8.1"
