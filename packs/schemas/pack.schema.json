{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanqa.dev/schemas/pack.schema.json",
  "title": "HumanQA community pack",
  "type": "object",
  "required": [
    "kind",
    "id",
    "name",
    "description",
    "author",
    "version",
    "compatibility",
    "tags",
    "definition"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": ["persona", "journey", "heuristic", "product-framework", "industry"]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 80
    },
    "name": { "type": "string", "minLength": 3, "maxLength": 100 },
    "description": { "type": "string", "minLength": 10, "maxLength": 500 },
    "author": { "type": "string", "minLength": 2, "maxLength": 120 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "compatibility": { "type": "string", "minLength": 4, "maxLength": 40 },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    },
    "definition": { "type": "object" }
  }
}
