{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanqa.dev/schemas/journey.schema.json",
  "title": "HumanQA journey pack",
  "allOf": [
    { "$ref": "./pack.schema.json" },
    {
      "type": "object",
      "properties": {
        "kind": { "const": "journey" },
        "definition": {
          "type": "object",
          "required": ["criticality", "steps"],
          "additionalProperties": false,
          "properties": {
            "start_path": { "type": "string", "minLength": 1 },
            "criticality": { "type": "integer", "minimum": 1, "maximum": 5 },
            "steps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "required": ["action"],
                "properties": {
                  "action": {
                    "enum": [
                      "goto",
                      "click",
                      "fill",
                      "assert-visible",
                      "assert-url",
                      "keyboard-reachable",
                      "wait",
                      "screenshot"
                    ]
                  },
                  "path": { "type": "string" },
                  "role": { "type": "string" },
                  "name": { "type": "string" },
                  "selector": { "type": "string" },
                  "test_id": { "type": "string" },
                  "label": { "type": "string" },
                  "value": { "type": "string" },
                  "text": { "type": "string" },
                  "pattern": { "type": "string" },
                  "criterion": { "type": "string" },
                  "rule": { "type": "string" },
                  "safe": { "type": "boolean" },
                  "sensitive": { "type": "boolean" },
                  "milliseconds": { "type": "integer", "minimum": 0, "maximum": 10000 },
                  "description": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  ]
}
